#!/bin/sh
set -eu
agent=/usr/local/libexec/zpnet-routing-agent
request=${SSH_ORIGINAL_COMMAND:-$*}
case "$request" in
  status|reconcile|dry-run|rollback|"automatic on"|"automatic off")
    # The forced command is allowlisted above; word splitting is required to form argv.
    # shellcheck disable=SC2086
    set -- $request
    exec "$agent" "$@"
    ;;
  "client set 10.66.0."*)
    # shellcheck disable=SC2086
    set -- $request
    [ "$#" = 4 ] && exec "$agent" "$@"
    ;;
esac
echo '{"error":"command is not allowed"}'
exit 64
